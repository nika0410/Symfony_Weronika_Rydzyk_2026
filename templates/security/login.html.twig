{% extends 'base.html.twig' %}

{% block title %}{{ 'title.login'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <form method="post" action="{{ path('app_login') }}">
                <h1 class="h3 mb-3 font-weight-normal">{{ 'title.login'|trans }}</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        {{ 'message.logged_in_as'|trans({'%username%': app.user.userIdentifier}) }},
                        <a href="{{ path('app_logout') }}">{{ 'action.logout'|trans }}</a>
                    </div>
                {% endif %}

                <label for="username">{{ 'label.email'|trans }}</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control mb-2" autocomplete="email" required autofocus>

                <label for="password">{{ 'label.password'|trans }}</label>
                <input type="password" name="_password" id="password" class="form-control mb-3" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-lg btn-primary w-100" type="submit">
                    {{ 'action.login'|trans }}
                </button>
            </form>

            <div class="text-center mt-3">
                <span class="text-muted">{{ 'message.no_account'|trans }}</span>
                <a href="{{ url('app_register') }}" class="btn btn-outline-secondary w-100 mt-2">
                    {{ 'action.register'|trans }}
                </a>
            </div>

        </div>

    </div>
{% endblock %}
