{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_list'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.user_list'|trans }}</h1>

    <div class="mb-3">
        <a href="{{ url('user_create') }}" class="btn btn-primary" title="{{ 'action.create.user'|trans }}">
            {{ 'action.create.user'|trans }}
        </a>
    </div>

    {% if pagination is defined and pagination.items|length %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'user.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.email'|trans, 'user.email') }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for user in pagination.items %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        <a href="{{ url('user_view', {id: user.id}) }}" title="{{ 'action.view'|trans }}">
                            {{ 'action.view'|trans }}
                        </a>
                        <a href="{{ url('user_edit', {id: user.id}) }}" title="{{ 'action.edit'|trans }}">
                            {{ 'action.edit'|trans }}
                        </a>
                        <a href="{{ url('user_delete', {id: user.id}) }}" title="{{ 'action.delete'|trans }}">
                            {{ 'action.delete'|trans }}
                        </a>

                        {% if 'ROLE_ADMIN' in user.roles %}
                            {% if user.id != app.user.id %}
                                <form method="post" action="{{ url('user_demote', {id: user.id}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('demote' ~ user.id) }}">
                                    <button class="btn btn-link p-0 align-baseline" type="submit">
                                        {{ 'action.demote'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        {% else %}
                            <form method="post" action="{{ url('user_promote', {id: user.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.id) }}">
                                <button class="btn btn-link p-0 align-baseline" type="submit">
                                    {{ 'action.promote'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="alert alert-warning" role="alert">
            {{ 'message.empty_list'|trans }}
        </div>
    {% endif %}
{% endblock %}
