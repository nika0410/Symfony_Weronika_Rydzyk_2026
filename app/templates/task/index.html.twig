{% extends 'base.html.twig' %}

{% block title %}Lista Zadań{% endblock %}

{% block body %}
    <h1>Wszystkie zadania</h1>

    <table class="table table-striped">
        <tr>
            <th>ID</th>
            <th>Tytuł</th>
            <th>Akcje</th>
        </tr>
        {% for task in tasks %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.title }}</td>
                <td>
                    {# Wywołanie url() linkujące do widoku pojedynczego rekordu #}
                    <a href="{{ url('task_view', {'id': task.id}) }}" class="btn btn-sm btn-primary">
                        Podgląd
                    </a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3">Brak zadań w bazie.</td></tr>
        {% endfor %}
    </table>
{% endblock %}
